digraph G { graph [rankdir=TB,bgcolor="white",nodesep=.32,ranksep=.38]; node [shape=box,style="rounded",fontname="Arial",fontsize=12,color="#334155",margin=".14,.10"]; edge [fontname="Arial",fontsize=10,color="#475569"];
